<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCS_Forms"
        xmlns:Core="clr-namespace:Core;assembly=Core" xmlns:Controls="clr-namespace:PCS_Forms.Controls" x:Class="PCS_Forms.MainWindow"
        mc:Ignorable="d"
        Title="Методика вычисления" WindowStartupLocation="CenterScreen" HorizontalAlignment="Center" HorizontalContentAlignment="Center" ResizeMode="CanMinimize" Width="1108" Height="667">
    <Grid x:Name="MainGrid" Background="#99B8F3B2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="313*"/>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="269*"/>
            <ColumnDefinition Width="99*"/>
            <ColumnDefinition Width="174*"/>
            <ColumnDefinition Width="57*"/>
            <ColumnDefinition Width="18*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="42*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="416*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTab"  Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="0,0,0,8"/>
        <Button x:Name="ButtonStartInterpretation" Content="Получить характеристику" Grid.Column="6" Grid.Row="5" FontWeight="Bold" Click="ButtonStartInterpretation_Click" >
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FF77FB71" Offset="1"/>
                    <GradientStop Color="White"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <GroupBox  Header="Данные теста" Grid.Column="1" Grid.Row="1" BorderBrush="#FF010113" Grid.RowSpan="5" >
            <Grid Name="TestDataGrid" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="117*" />
                    <ColumnDefinition Width="196*" />
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="19*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="27*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="147*"/>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="313*"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.ColumnSpan="3" Header="Тестируемый" Grid.Row="6" Margin="0,0,0,3" BorderBrush="#FF081015" >
                    <Grid Margin="0,1,2,-4" Name="TestedDataGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="12*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition    />
                            <RowDefinition  />
                            <RowDefinition   />
                            <RowDefinition   />
                            <RowDefinition />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                        </Grid.RowDefinitions>
                        <Label Content="Образование" Grid.Row="4" Margin="11,21,11,6" Grid.RowSpan="2" />
                        <Label Content="Состав семьи" Grid.Row="5" Margin="11,24,11,2" Grid.RowSpan="2"/>
                        <Label Content="Особенности" Grid.Row="7" HorizontalContentAlignment="Center" Margin="0,3,0,24" Grid.RowSpan="2"   />
                        <Label Content="Приводы" Grid.Row="8" ToolTip="Приводы в полицию" Margin="22,6,23,21" Grid.RowSpan="2"/>
                        <Label Content="Суициды в семье" Grid.Row="9" Margin="0,9,1,18" Grid.RowSpan="2" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Name="ComboboxEducaton" Margin="0,21,0,6" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Name="ComboboxCompositionOfFamily" Margin="0,24,0,2" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Name="ComboboxDefects" Margin="0,3,0,24" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" Name="ComboboxDetained" Margin="0,6,0,21" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="9" Grid.Column="1" Name="ComboboxSuicideIfFamily" Margin="0,9,0,18" Grid.RowSpan="2"/>
                        <Label Content="Фамилия" HorizontalContentAlignment="Center" Margin="0,23,0,3" Grid.RowSpan="2"/>
                        <Label Content="Имя" Grid.Row="2" HorizontalContentAlignment="Center"/>
                        <Label Content="Отчество"  Grid.Row="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,3,0,24" Grid.RowSpan="2"   />
                        <TextBox Grid.Column="1" TextWrapping="Wrap" x:Name="TextBoxSurname" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="4" Margin="0,23,0,3" Grid.RowSpan="2"/>
                        <TextBox x:Name="TextBoxName" Grid.Column="1" Grid.Row="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="5" />
                        <TextBox Grid.Column="1"  Grid.Row="3" x:Name="TextBoxLastName" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="6" Margin="0,3,0,24" Grid.RowSpan="2" />
                    </Grid>
                </GroupBox>
                <Label Content="Выбор методики" HorizontalContentAlignment="Center" Margin="0,17,0,2" Grid.RowSpan="2"/>
                <Label Content="Дата тестирования" Grid.Row="2" Grid.Column="0" HorizontalContentAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="ComboBoxMethod" TabIndex="0" SelectionChanged="ComboBoxMethod_SelectionChanged" Margin="0,17,0,2" Grid.RowSpan="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <DatePicker Name="DatePickerTesting" Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Center" Background="White" />
                <GroupBox Header="Психолог"  Grid.Row="4"  Grid.ColumnSpan="3" BorderBrush="#FF0C151B" >
                    <Grid Name="PsyDataGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="12*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Column="1" Name="TextBoxPsySurname" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="1" Margin="0,22,0,3" Grid.RowSpan="2" />
                        <TextBox Grid.Row="2" Grid.Column="1" Name="TextBoxPsyName" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="TextBoxPsyLastname" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="3" Margin="0,4,0,21" Grid.RowSpan="2"/>
                        <Label Content="Фамилия" HorizontalContentAlignment="Center" Margin="0,22,0,3" Grid.RowSpan="2"/>
                        <Label Grid.Row="2" Content="Имя" HorizontalContentAlignment="Center"></Label>
                        <Label Grid.Row="3" Content="Отчество" HorizontalContentAlignment="Center" Margin="0,4,0,21" Grid.RowSpan="2"></Label>
                    </Grid>
                </GroupBox>
            </Grid>

        </GroupBox>
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Height="20" VerticalAlignment="Top">
            <MenuItem Header="Файл" Margin="5,0,0,0">
                <MenuItem Name="MenuItemExit" Header="Выход" Click="EventExit"></MenuItem>
            </MenuItem>
            <MenuItem Header="Тестирование">
                <MenuItem Name="MenuItemStartInterpretation" Header="Получить характеристику" Click="ButtonStartInterpretation_Click"></MenuItem>
                <MenuItem Header="Результаты прошлых тестирований"/>
                <MenuItem Header="Словарь терминов"/>
            </MenuItem>
            <MenuItem Header="Управление">
                
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О нас"/>
            </MenuItem>
        </Menu>
        <Image Grid.ColumnSpan="1" Grid.Column="7" Grid.Row="1" Source="Images/Logo.png" />
        <TextBlock Grid.Column="3"  Grid.Row="1" Grid.ColumnSpan="4" Text="ПРОГРАММА РАСЧЕТА РЕЗУЛЬТАТОВ ПСИХОЛОГИЧЕСКОГО ТЕСТИРОВАНИЯ" FontSize="19" VerticalAlignment="Center" Height="26" Margin="0,8"  />
    </Grid>
</Window>
