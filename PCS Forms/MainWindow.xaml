<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCS_Forms"
        xmlns:Core="clr-namespace:Core;assembly=Core" xmlns:Controls="clr-namespace:PCS_Forms.Controls" x:Class="PCS_Forms.MainWindow"
        mc:Ignorable="d"
        Title="Расчет результатов психологического тестирования" WindowStartupLocation="CenterScreen" HorizontalAlignment="Center" HorizontalContentAlignment="Center"  Width="1108" Height="667" Closing="EventExit" Icon="Images/Logo.ico">
    <Grid x:Name="MainGrid" Background="#99B8F3B2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="313*"/>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="68*"/>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="174*"/>
            <ColumnDefinition Width="57*"/>
            <ColumnDefinition Width="18*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="414*"/>
            <RowDefinition Height="62*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="16*"/>
        </Grid.RowDefinitions>
        <Button x:Name="ButtonStartInterpretation" Content="Получить характеристику" Grid.Column="11" Grid.Row="7" FontWeight="Bold" Click="ButtonStartInterpretation_Click" >
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FF77FB71" Offset="1"/>
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF7AFB74" Offset="0.977"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <GroupBox  Header="Данные теста" Grid.Column="1" Grid.Row="1" BorderBrush="#FF010113" Grid.RowSpan="7" >
            <Grid Name="TestDataGrid" Margin="2,0,-2,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128*" />
                    <ColumnDefinition Width="169*" />
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="167*"/>
                    <RowDefinition Height="91*"/>
                    <RowDefinition Height="313*"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.ColumnSpan="3" Header="Тестируемый" Grid.Row="2" Margin="0,0,0,3" BorderBrush="#FF081015" >
                    <Grid Margin="0,1,2,-4" Name="TestedDataGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="12*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition    />
                            <RowDefinition  />
                            <RowDefinition   />
                            <RowDefinition   />
                            <RowDefinition />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                            <RowDefinition    />
                        </Grid.RowDefinitions>
                        <Label Content="Образование" Grid.Row="4" Margin="11,21,11,6" Grid.RowSpan="2" />
                        <Label Content="Состав семьи" Grid.Row="5" Margin="11,24,11,2" Grid.RowSpan="2"/>
                        <Label Content="Особенности" Grid.Row="7" HorizontalContentAlignment="Center" Margin="0,3,0,24" Grid.RowSpan="2"   />
                        <Label Content="Приводы" Grid.Row="8" ToolTip="Приводы в полицию" Margin="22,6,23,21" Grid.RowSpan="2"/>
                        <Label Content="Суициды в семье" Grid.Row="9" Margin="0,9,1,18" Grid.RowSpan="2" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Name="ComboboxEducaton" Margin="0,21,0,6" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Name="ComboboxCompositionOfFamily" Margin="0,24,0,2" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Name="ComboboxDefects" Margin="0,3,0,24" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" Name="ComboboxDetained" Margin="0,6,0,21" Grid.RowSpan="2"/>
                        <ComboBox Grid.Row="9" Grid.Column="1" Name="ComboboxSuicideIfFamily" Margin="0,9,0,18" Grid.RowSpan="2"/>
                        <Label Content="Фамилия" HorizontalContentAlignment="Center" Margin="0,23,0,3" Grid.RowSpan="2"/>
                        <Label Content="Имя" Grid.Row="2" HorizontalContentAlignment="Center"/>
                        <Label Content="Отчество"  Grid.Row="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,3,0,24" Grid.RowSpan="2"   />
                        <Controls:MyTextBox Text="{Binding Surname}" x:Name="TextBoxSurname" Grid.Column="1" TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="4" Margin="0,23,0,3" Grid.RowSpan="2" Background="#FFF7FF51" TextChanged="TextBox_TextChanged" FontWeight="Bold"/>
                        <Controls:MyTextBox Text="{Binding Name}" x:Name="TextBoxName" Grid.Column="1" Grid.Row="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="5" Background="#FFF7FF51" TextChanged="TextBox_TextChanged" FontWeight="Bold" Margin="0,0,0,2" />
                        <Controls:MyTextBox Text="{Binding Lastname}" x:Name="TextBoxLastName"  Grid.Column="1"  Grid.Row="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="6" Margin="0,3,0,24" Grid.RowSpan="2" Background="#FFF7FF51" TextChanged="TextBox_TextChanged" FontWeight="Bold" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Методика" Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#FF080808">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="47*"/>
                            <ColumnDefinition Width="48*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="43*"/>
                            <RowDefinition Height="42*"/>
                        </Grid.RowDefinitions>
                        <Label Content="Выбор методики" HorizontalContentAlignment="Center" />
                        <Label Content="Дата тестирования" Grid.Column="0" HorizontalContentAlignment="Center"  Grid.Row="1" />
                        <ComboBox x:Name="ComboBoxMethod" TabIndex="0" SelectionChanged="ComboBoxMethod_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="1" Margin="0,5" />
                        <DatePicker Name="DatePickerTesting" HorizontalContentAlignment="Center" Background="White" FirstDayOfWeek="Monday" SelectedDateFormat="Short"  Grid.Column="1" Grid.Row="1" Margin="0,5"  />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Психолог"  Grid.ColumnSpan="3" BorderBrush="#FF0C151B" Margin="0,10,0,5" Foreground="#FF0A0909" Background="#FFBEFFBB" >
                    <Grid Name="PsyDataGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="12*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Column="1" Name="TextBoxPsySurname" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="1" Margin="0,22,0,3" Grid.RowSpan="2" FontWeight="Bold" SelectionOpacity="0.1" IsEnabled="False" />
                        <TextBox Grid.Row="2" Grid.Column="1" Name="TextBoxPsyName" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="2" FontWeight="Bold" SelectionOpacity="0.1" IsEnabled="False"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="TextBoxPsyLastname" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TabIndex="3" Margin="0,4,0,21" Grid.RowSpan="2" FontWeight="Bold" SelectionOpacity="0.1" IsEnabled="False"/>
                        <Label Content="Фамилия" HorizontalContentAlignment="Center" Margin="0,22,0,3" Grid.RowSpan="2"/>
                        <Label Grid.Row="2" Content="Имя" HorizontalContentAlignment="Center"></Label>
                        <Label Grid.Row="3" Content="Отчество" HorizontalContentAlignment="Center" Margin="0,4,0,21" Grid.RowSpan="2"></Label>
                    </Grid>
                </GroupBox>
            </Grid>

        </GroupBox>
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="14" Height="20" VerticalAlignment="Top">
            <MenuItem Header="Файл" Margin="5,0,0,0">
                <MenuItem Name="MenuItemExit" Header="Выход" Click="ButtonClose_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="Тестирование">
                <MenuItem Header="Получить характеристику" Click="ButtonStartInterpretation_Click"/>
                <MenuItem Header="Сохранить результаты" Click="ButtonSaveResults_Click"/>
                <MenuItem Header="Очистить результаты" Click="ButtoClearResults_Click"/>
                <MenuItem Header="Результаты прошлых тестирований" Click="ButtonLastResults_Click"/>
                <MenuItem Header="Словарь терминов" Click="ButtonOpenTermsDictionary_Click"/>
            </MenuItem>
            <MenuItem Header="Управление">
                <MenuItem Header="Cбросить текущего пользователя" Click="ButtonSetAccountAsUnactive"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О нас"/>
            </MenuItem>
        </Menu>
        <Image Grid.ColumnSpan="1" Grid.Column="12" Grid.Row="1" Source="Images/Logo.png" />
        <TextBlock Grid.Column="3"  Grid.Row="1" Grid.ColumnSpan="9" Text="ПРОГРАММА РАСЧЕТА РЕЗУЛЬТАТОВ ПСИХОЛОГИЧЕСКОГО ТЕСТИРОВАНИЯ" FontSize="19" VerticalAlignment="Center" Height="26" Margin="0,9"  />
        <Button Content="Очистить результаты" Grid.Column="5"  Grid.Row="7" Grid.ColumnSpan="2" FontWeight="Bold" Click="ButtoClearResults_Click" IsCancel="True" >
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE4E4E4" Offset="0.004"/>
                    <GradientStop Color="#FFDC0000" Offset="1"/>
                    <GradientStop Color="#FEE2B0B0" Offset="0.323"/>
                    <GradientStop Color="#FEE07E7E" Offset="0.624"/>
                    <GradientStop Color="#FEDE4848" Offset="0.84"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Grid.ColumnSpan="2" Content="Сохранить результаты" Grid.Column="8" Grid.Row="7" Click="ButtonSaveResults_Click" FontWeight="Bold" >
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Snow" Offset="0"/>
                    <GradientStop Color="#FF2D4ACB" Offset="1"/>
                    <GradientStop Color="#FFB8BEEA" Offset="0.304"/>
                    <GradientStop Color="#FF8F9CE0" Offset="0.563"/>
                    <GradientStop Color="#FF5C71D5" Offset="0.757"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <StackPanel Name="MainStackPanel" Grid.ColumnSpan="10" Grid.Column="3" Grid.Row="4" Grid.RowSpan="2" Background="White">
        </StackPanel>
        <StackPanel x:Name="ActiveTestStackPanel" Grid.Column="3" Grid.Row="2" Grid.ColumnSpan="10" Background="White" Orientation="Horizontal"/>
    </Grid>
</Window>
