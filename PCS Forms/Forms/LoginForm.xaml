<Window x:Name="Login" x:Class="PCS_Forms.Windows.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="228.92" Width="416.598" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Icon="/PSC;component/Images/Logo.ico" ShowInTaskbar="False" AllowsTransparency="True" WindowStyle="None">
    <Grid Background="#99B8F3B2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="107*"/>
            <ColumnDefinition Width="256*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54*"/>
            <RowDefinition Height="39*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="77*"/>
        </Grid.RowDefinitions>

        <PasswordBox x:Name="PasswordBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="1"/>
        <Label Content="Пароль"           HorizontalContentAlignment="Right"  VerticalContentAlignment="Center" Grid.Row="2"  />
        <Label Content="Здравствуйте,"    HorizontalContentAlignment="Right"  VerticalContentAlignment="Center" Grid.Row="1"/>
        <Label Content="{Binding Path=Psy.FullName, Mode=OneWay}" x:Name="FullNamePsychologist"  FontWeight="Bold" HorizontalAlignment="Left" Width="256" VerticalContentAlignment="Center" Margin="0,2,0,0" Grid.Column="1" Grid.Row="1" />
        <Button Content="Войти" Click="ButtonSignUp_Click" Background="#FF99B0FF" RenderTransformOrigin="0.5,0.5" BorderBrush="White" IsDefault="True" Margin="0,34,149,27" Grid.Row="3" Grid.Column="1" />
        <Button Content="Выйти" Click="ButtonClose_Click" Background="#FFFF9F9F" RenderTransformOrigin="0.5,0.5" BorderBrush="White" IsDefault="True" Margin="155,34,0,27" Grid.Row="3" Grid.Column="1" />
    </Grid>
</Window>
