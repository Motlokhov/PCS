<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib" x:Name="LastResults" x:Class="PCS_Forms.Windows.LastResultsForm"
        Title="Результаты прошлых тестирований" Height="487.68" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="646" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Icon="/PSC;component/Images/Logo.ico" Background="#99B8F3B2">
    <ListView x:Name="DataResults" Margin="10">
        <ListView.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Number}"/>
                    <Label Content="{Binding Method}"/>
                    <Label Content="{Binding Date}"/>
                    <Label Content="{Binding Tested.FullName}"/>
                    <Label Content="{Binding Psy.FullName}"/>
                    <Button Click="button_Click" Content="Результаты" Tag="{Binding Number}"/>
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Window>
