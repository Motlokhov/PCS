<Window x:Name="ResultsWindow1" x:Class="PCS_Forms.Windows.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResultsWindow" Height="459.701" Width="834.328" ResizeMode="CanMinimize">
    <Grid Background="#FFD2FFAC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*"/>
            <ColumnDefinition Width="118*"/>
            <ColumnDefinition Width="528*"/>
            <ColumnDefinition Width="115*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="370*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <RichTextBox x:Name="ResultsList" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" IsDocumentEnabled="True" ScrollViewer.VerticalScrollBarVisibility="Visible"  >
            <FlowDocument FontSize="13"/>
        </RichTextBox>
        <Button Content="Открыть в Word" Grid.Column="3" Grid.Row="3" FontWeight="Bold" Background="#FF515AFF" Foreground="White" Click="ButtonWord_Click" />
        <Button Content="Закрыть" Grid.Column="1"  Grid.Row="3" Background="#FFF55A5A" FontWeight="Bold" Foreground="#FFF" Click="ButtonExit_Click"/>
    </Grid>
</Window>
