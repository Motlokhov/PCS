<Window x:Name="ResultsWindow1" x:Class="PCS_Forms.Windows.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResultsWindow" Height="459.701" Width="834.328" ResizeMode="CanMinimize">
    <Grid x:Name="ResultsWindow2" Background="#99B8F3B2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24*"/>
            <ColumnDefinition Width="118*"/>
            <ColumnDefinition Width="528*"/>
            <ColumnDefinition Width="115*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="370*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <RichTextBox x:Name="ResultsList" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" IsDocumentEnabled="True" ScrollViewer.VerticalScrollBarVisibility="Visible"  >
            <FlowDocument FontSize="13"/>
        </RichTextBox>
        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"></StackPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,10,10,80" VerticalAlignment="Bottom">
                        <Border Name="border" Margin="3,10,3,10" Background="Blue"
                                Width="10" BorderBrush="Blue" BorderThickness="3"
                                Height="{Binding Data}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation From="0" Duration="0:0:02.0"
                                                             Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="FrameworkElement.Height">
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold"
                                   FontFamily="Arial" Text="{Binding Value}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Foreground="Black"
                                   FontWeight="Bold" FontFamily="Arial"
                                   Text="{Binding Name}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Открыть в Word" Grid.Column="3" Grid.Row="3" FontWeight="Bold" Background="#FF515AFF" Foreground="White" Click="ButtonWord_Click" />
        <Button Content="Закрыть" Grid.Column="1"  Grid.Row="3" Background="#FFF55A5A" FontWeight="Bold" Foreground="#FFF" Click="ButtonExit_Click"/>
    </Grid>
</Window>
