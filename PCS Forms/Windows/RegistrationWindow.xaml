<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:PCS_Forms.Controls" x:Class="PCS_Forms.Windows.RegistrationWindow"
        Title="Регистрация" Height="256.963" Width="330.44" Closing="RegistrationWindow_Closing" Background="#99B8F3B0" Icon="/PSC;component/Images/Logo.ico">
    <Grid Background="#99B8F3B2">
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="23*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="178*"/>
            <ColumnDefinition Width="180*"/>
            <ColumnDefinition Width="25*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Фамилия" Grid.Column="1"  Grid.Row="1" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center"/>
        <Label Content="Имя" Grid.Column="1"  Grid.Row="3" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center"/>
        <Label Content="Отчество" Grid.Column="1"  Grid.Row="5" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center" />
        <Label Content="Пароль" Grid.Column="1"  Grid.Row="7" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center" />
        <Label Content="Повторите пароль" Grid.Column="1"  Grid.Row="9" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center" />
        <Controls:MyTextBox x:Name="Surname" Grid.Column="2" Grid.Row="1" HorizontalContentAlignment="Center" FontWeight="Bold" VerticalContentAlignment="Center" Margin="0"  />
        <Controls:MyTextBox x:Name ="name" Grid.Column="2" Grid.Row="3" HorizontalContentAlignment="Center" FontWeight="Bold" VerticalContentAlignment="Center" Margin="0"  />
        <Controls:MyTextBox x:Name ="LastName" Grid.Column="2" Grid.Row="5" HorizontalContentAlignment="Center" FontWeight="Bold" VerticalContentAlignment="Center" Margin="0"  />
        <PasswordBox x:Name="Password" Grid.Column="2" Grid.Row="7" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFF9F905"   />
        <PasswordBox x:Name="RepeatPassowrd" Grid.Column="2" Grid.Row="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFF9F905" />
        <Button x:Name="b" Content="Зарегистрироваться" Grid.Column="2" Grid.Row="11" Click="ButtonSignIn_Click" Background="#FF94C5FF" Cursor="Hand" IsDefault="True" />
    </Grid>
</Window>
